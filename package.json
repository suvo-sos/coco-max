{
  "name": "coco",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "node apps/preview/deploy.mjs",
    "deploy:vercel": "npx --yes vercel@64 build && npx --yes vercel@64 deploy --prebuilt",
    "deploy:netlify": "npx --yes netlify-cli@27 deploy --build",
    "deploy:cloudflare": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name coco"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@videojs/core": "10.3.0",
    "@videojs/react": "10.3.0",
    "cn": "^0.4.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.12.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@videojs/mux-video": "10.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
